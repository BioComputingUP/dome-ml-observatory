# dome-ml-observatory -- configuration template.
#
# Copy this file to .env, then set MONGODB_URI in step 1 below. Everything else
# already works as shipped and can be left alone:
#
#   cp .env.example .env
#
# This template is committed to the repository, so it must never contain a real
# host, password or token. Your own .env is gitignored and must never be
# committed.
#
# This root copy is read by docker-compose-local.yml (`env_file: .env`) and
# passed to the observatory-ws container, which is the supported way to run the
# service. Running the backend outside Docker instead reads a separate file --
# see observatory-ws/.env.example. The frontend needs no variables at all.
#
# Every variable is validated when the service starts, so a missing or malformed
# value stops startup and names itself, rather than failing later on a request.
# Full reference for each one: observatory-ws/README.md


# =============================================================================
# 1. DATABASE -- the only thing you have to decide. Pick ONE of A, B or C.
# =============================================================================
#
# --- A. Sample data. Nothing to install, no VPN. Start here if you are new. ---
#
#   Runs a throwaway MongoDB inside Docker, seeded with a bundled 200-record
#   sample, so the whole stack works with no access to any real database.
#
# --- B. The real corpus database. This is what the live line below is for. ---
#
#   Replace "mongodb-host" with the database host. That host is reachable only
#   from the hosting institution's network, so you also need the UNIPD
#   Biocomputing VPN. The address is shared out of band, not through this
#   repository.
#
# --- C. A MongoDB already running on your own machine (not in Compose). ------
#
# -----------------------------------------------------------------------------
#
# HOW TO SWITCH: option B means editing the live line below. Options A and C
# are the commented lines underneath it -- just delete the "#" from the one you
# want. It does not matter that the live line is still there: a later line wins,
# so whichever option you uncomment overrides it.

MONGODB_URI=mongodb://mongodb-host:27017

# --- Option A. Uncomment the next line, then start the stack WITH the offline
#     profile. The --profile flag is required; without it the throwaway
#     database is never created:
#
#       docker compose -f docker-compose-local.yml --profile offline up --build
#
# MONGODB_URI=mongodb://mongo:27017

# --- Option C. Use host.docker.internal, NOT localhost: inside a container
#     "localhost" means the container itself. That mistake fails silently on
#     Linux while appearing to work on macOS.
#
# MONGODB_URI=mongodb://host.docker.internal:27017

# Leave these two as they are. They are the real names, and the bundled sample
# data in option A is seeded under exactly the same names.
MONGODB_DB=dome_observatory
MONGODB_COLLECTION=Content


# =============================================================================
# 2. SERVICE
# =============================================================================

# Port the backend listens on. Must stay 3000: the frontend's nginx proxies
# /api/ to observatory-ws:3000 and never reads this value.
PORT=3000

# CORS origin allowlist. It only applies when the frontend is served from a
# different origin than the API -- the Docker and production setups both proxy
# /api/ same-origin through nginx, so the browser never needs CORS there. It
# matters for a frontend dev server running without its proxy config, or a
# future split-host deployment. Never set this to '*'.
FRONTEND_URL=http://localhost:4200


# =============================================================================
# 3. QUERY TIME BUDGETS, in milliseconds -- optional; these are the defaults
# =============================================================================
# A query that exceeds its budget fails that one request, instead of holding a
# connection open on a database host shared with other services.

# Filter-only queries.
MONGO_MAX_TIME_MS=5000

# Free-text search (q=...) only, which is genuinely slower -- a rare term or
# author surname measured about 10s against the unindexed collection.
MONGO_SEARCH_MAX_TIME_MS=20000

# One /api/export chunk, which is up to 1000 documents rather than 25.
MONGO_EXPORT_MAX_TIME_MS=30000


# =============================================================================
# 4. RATE LIMITS, per client IP per minute -- optional; these are the defaults
# =============================================================================
# An abuse backstop on a shared database host, not a ration -- raise them if the
# hosting deployment can carry more. The first is a single budget shared across
# all endpoints; /api/export gets its own smaller one because each of those
# requests returns up to 1000 records.
#
# These numbers are also quoted in README.md, in swagger.ts and on the
# /download/api page, and nothing keeps them in sync. Change a limit here and
# those need updating too.
RATE_LIMIT_PER_MINUTE=1200
EXPORT_RATE_LIMIT_PER_MINUTE=60


# =============================================================================
# 5. FRONTEND DEPLOY TARGET -- optional, and only in this root file
# =============================================================================
# An rsync destination used by `npm run deploy-prod-quick`. Not read by the
# service. Deliberately left unset: the script exits with a message rather than
# deploying somewhere unintended. Export it from your shell instead of
# committing a value here.
# DEPLOY_TARGET=user@host:/var/www/dome-ml-observatory/dist/


# =============================================================================
# 6. ANALYTICS (Matomo) -- optional, and OFF unless MATOMO_TOKEN is set
# =============================================================================
# All four are optional, and the whole integration is inert while MATOMO_TOKEN
# is unset, which is the shipped default: no tracker is constructed and no host
# is contacted. See ROADMAP.md section 1 for how to turn it on.
#
# MATOMO_TOKEN is the ONLY credential this service has. Never commit it --
# supply it from the deployment environment, or a GitHub Actions secret if CI
# ever needs it. It is also what makes the client IP be honoured: without it,
# Matomo attributes every API hit to this server rather than to the caller.
# MATOMO_URL=https://matomo.biocomputingup.it/matomo.php
# MATOMO_SITE_ID=
# MATOMO_TOKEN=
# MATOMO_PUBLIC_ORIGIN=https://observatory.dome-ml.org
