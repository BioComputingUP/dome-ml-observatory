{
  "name": "observatory-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "node scripts/sync-schema.js",
    "build-dev": "ng build --configuration development",
    "prebuild-dev": "node scripts/sync-schema.js",
    "build-prod": "ng build",
    "prebuild-prod": "node scripts/sync-schema.js",
    "deploy-prod-quick": "(colC='\\033[0;36m';colN='\\033[0m'; echo ${colC}Running npm build-prod ...${colN} && npm run build-prod && echo ${colC}Rsyncing dist ...${colN} && rsync -avh --delete dist/* REDACTED-DEPLOY-TARGET:/var/www/dome-ml-observatory/dist/ && echo ${colC}Done with deploy-prod-quick!${colC})",
    "test": "ng test",
    "pretest": "node scripts/sync-schema.js",
    "lint": "ng lint",
    "sync-schema": "node scripts/sync-schema.js"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.2"
  }
}
