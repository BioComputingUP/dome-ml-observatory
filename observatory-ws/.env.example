# observatory-ws config -- copy to .env and fill in real values. Never commit .env itself.
#
# Every value here is read straight from process.env at boot (src/config/env.validation.ts) and
# validated before the app starts -- there is deliberately no environments/*.yaml file baked into
# the image, unlike dome-registry-ws, because production secrets are set by whoever operates the
# deployment, not baked in here
# and a Docker image should carry no environment-specific config at all.

# Mongo connection. Placeholder only -- set the real host in your own .env, which is gitignored.
# For local development this is the database server reachable over your network or VPN; in a
# server deployment it is the MongoDB host that deployment provides. The database and collection
# names below are the real ones and should not need changing.
MONGODB_URI=mongodb://mongodb-host:27017
MONGODB_DB=dome_observatory
MONGODB_COLLECTION=Content

PORT=3000

# Restricts CORS to the frontend origin. In both the Docker and bare-metal deployment, nginx
# proxies /api/* same-origin so the browser never actually needs CORS -- this only matters for
# `npm run start:dev` against `ng serve` when proxy.conf.json isn't in play, or a future split-host
# deployment. Never leave this as '*' in production.
FRONTEND_URL=http://localhost:4200

# Cap on how long any single Mongo query is allowed to run (maxTimeMS) before the API fails that
# request fast rather than holding a connection open on a shared host. See records.query.ts.
MONGO_MAX_TIME_MS=5000

# Separate, larger budget applied only to a free-text search (q=...). A rare term or author
# surname is a genuine ~10s query on the MongoDB server's unindexed collection -- measured "Tosatto" at 10.0s.
# See records.service.ts's fetchPage and configuration.ts.
MONGO_SEARCH_MAX_TIME_MS=20000
