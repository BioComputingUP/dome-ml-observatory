# observatory-ws -- configuration template for running the backend OUTSIDE Docker.
#
# Copy this file to .env in this same folder, then set MONGODB_URI in step 1
# below. Everything else already works as shipped and can be left alone:
#
#   cp .env.example .env      # creates observatory-ws/.env
#   npm run start:dev
#
# This template is committed to the repository, so it must never contain a real
# host, password or token. Your own .env is gitignored and must never be
# committed.
#
# WHICH FILE DO I EDIT?
#   Running with Docker (the supported way to run the service) reads the
#   repo-root .env instead -- Compose passes it to the container, and this file
#   is not involved at all. Use this one only for `npm run start:dev` from
#   inside observatory-ws/, where @nestjs/config looks in the current folder.
#   The frontend needs no variables either way.
#
# Every variable is validated when the service starts, so a missing or malformed
# value stops startup and names itself, rather than failing later on a request.
# Full reference for each one: README.md in this folder.


# =============================================================================
# 1. DATABASE -- the only thing you have to decide. Pick A or B.
# =============================================================================
#
# Running outside Docker, this must be a database your own machine can reach
# directly.
#
# --- A. The real corpus database. This is what the live line below is for. ---
#
#   Replace "mongodb-host" with the database host. That host is reachable only
#   from the hosting institution's network, so you also need the UNIPD
#   Biocomputing VPN. The address is shared out of band, not through this
#   repository.
#
# --- B. A MongoDB running on your own machine. -------------------------------
#
#   Set the live line below to:  mongodb://localhost:27017
#   Plain "localhost" is correct here, because the backend runs directly on your
#   machine rather than inside a container.
#
# WANT SAMPLE DATA INSTEAD OF A REAL DATABASE?
#   The bundled 200-record sample stack is Docker-only. Its MongoDB sits on the
#   Compose network and publishes no port to your machine, so `npm run
#   start:dev` cannot reach it. Run the whole stack with Docker for that, using
#   the repo-root .env and option A in the root .env.example.
#
# -----------------------------------------------------------------------------

MONGODB_URI=mongodb://mongodb-host:27017

# The two values below belong to the Docker path and do NOT work from here.
# They are kept so both templates list the same alternatives:
#
#   the sample database, reachable only from inside the Compose network --
# MONGODB_URI=mongodb://mongo:27017
#
#   a MongoDB on your host machine, as seen from inside a container --
# MONGODB_URI=mongodb://host.docker.internal:27017

# Leave these two as they are. They are the real names, and the bundled sample
# data is seeded under exactly the same names.
MONGODB_DB=dome_observatory
MONGODB_COLLECTION=Content


# =============================================================================
# 2. SERVICE
# =============================================================================

# Port the backend listens on. Keep it at 3000 unless you have a reason: the
# frontend dev server's proxy.conf.json and nginx both target port 3000.
PORT=3000

# CORS origin allowlist. This is the setting that actually matters when
# developing outside Docker: `npm run start:dev` against `ng serve` needs the
# frontend's origin here whenever proxy.conf.json is not in play. Under Docker
# and in production, nginx proxies /api/ same-origin and the browser never needs
# CORS at all. Never set this to '*'.
FRONTEND_URL=http://localhost:4200


# =============================================================================
# 3. QUERY TIME BUDGETS, in milliseconds -- optional; these are the defaults
# =============================================================================
# A query that exceeds its budget fails that one request, instead of holding a
# connection open on a database host shared with other services.

# Filter-only queries.
MONGO_MAX_TIME_MS=5000

# Free-text search (q=...) only, which is genuinely slower -- a rare term or
# author surname measured about 10s against the unindexed collection.
MONGO_SEARCH_MAX_TIME_MS=20000

# One /api/export chunk, which is up to 1000 documents rather than 25.
MONGO_EXPORT_MAX_TIME_MS=30000


# =============================================================================
# 4. RATE LIMITS, per client IP per minute -- optional; these are the defaults
# =============================================================================
# An abuse backstop on a shared database host, not a ration -- raise them if the
# hosting deployment can carry more. The first is a single budget shared across
# all endpoints; /api/export gets its own smaller one because each of those
# requests returns up to 1000 records.
#
# These numbers are also quoted in README.md, in swagger.ts and on the
# /download/api page, and nothing keeps them in sync. Change a limit here and
# those need updating too.
RATE_LIMIT_PER_MINUTE=1200
EXPORT_RATE_LIMIT_PER_MINUTE=60


# =============================================================================
# 5. ANALYTICS (Matomo) -- optional, and OFF unless MATOMO_TOKEN is set
# =============================================================================
# All four are optional, and the whole integration is inert while MATOMO_TOKEN
# is unset, which is the shipped default: no tracker is constructed and no host
# is contacted. See ROADMAP.md section 1 for how to turn it on.
#
# MATOMO_TOKEN is the ONLY credential this service has. Never commit it --
# supply it from the deployment environment, or a GitHub Actions secret if CI
# ever needs it. It is also what makes the client IP be honoured: without it,
# Matomo attributes every API hit to this server rather than to the caller.
# MATOMO_URL=https://matomo.biocomputingup.it/matomo.php
# MATOMO_SITE_ID=
# MATOMO_TOKEN=
# MATOMO_PUBLIC_ORIGIN=https://observatory.dome-ml.org
